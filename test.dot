digraph "calculator" {
node [
  fontsize = "12"
];
subgraph clusterLegend {
  label = "Legend";
  color = black;
  edge [ style = invis ];
  legendNode0 [ label = "Executable", shape = egg ];
  legendNode1 [ label = "Static Library", shape = octagon ];
  legendNode2 [ label = "Shared Library", shape = doubleoctagon ];
  legendNode3 [ label = "Module Library", shape = tripleoctagon ];
  legendNode4 [ label = "Interface Library", shape = pentagon ];
  legendNode5 [ label = "Object Library", shape = hexagon ];
  legendNode6 [ label = "Unknown Library", shape = septagon ];
  legendNode7 [ label = "Custom Target", shape = box ];
  legendNode0 -> legendNode1 [ style = solid ];
  legendNode0 -> legendNode2 [ style = solid ];
  legendNode0 -> legendNode3;
  legendNode1 -> legendNode4 [ label = "Interface", style = dashed ];
  legendNode2 -> legendNode5 [ label = "Private", style = dotted ];
  legendNode3 -> legendNode6 [ style = solid ];
  legendNode0 -> legendNode7;
}
    "node0" [ label = "calculator-tests", shape = egg ];
    "node1" [ label = "GTest::gtest_main", shape = doubleoctagon ];
    "node2" [ label = "GTest::gtest", shape = doubleoctagon ];
    "node3" [ label = "Threads::Threads", shape = pentagon ];
    "node2" -> "node3" [ style = dashed ] // GTest::gtest -> Threads::Threads
    "node1" -> "node2" [ style = dashed ] // GTest::gtest_main -> GTest::gtest
    "node1" -> "node3" [ style = dashed ] // GTest::gtest_main -> Threads::Threads
    "node0" -> "node1" [ style = dotted ] // calculator-tests -> GTest::gtest_main
    "node0" -> "node0"  // calculator-tests -> calculator-tests
    "node4" [ label = "lib", shape = pentagon ];
    "node5" [ label = "parser", shape = octagon ];
    "node6" [ label = "features", shape = octagon ];
    "node6" -> "node5"  // features -> parser
    "node5" -> "node6"  // parser -> features
    "node7" [ label = "tokenizer", shape = octagon ];
    "node6" -> "node7"  // features -> tokenizer
    "node8" [ label = "utilities", shape = octagon ];
    "node6" -> "node8"  // features -> utilities
    "node4" -> "node5" [ style = dashed ] // lib -> parser
    "node4" -> "node7" [ style = dashed ] // lib -> tokenizer
    "node4" -> "node8" [ style = dashed ] // lib -> utilities
    "node0" -> "node4" [ style = dotted ] // calculator-tests -> lib
    "node9" [ label = "scientific-calculator", shape = egg ];
    "node9" -> "node4" [ style = dotted ] // scientific-calculator -> lib
    "node10" [ label = "standard-calculator", shape = egg ];
    "node10" -> "node4" [ style = dotted ] // standard-calculator -> lib
}
